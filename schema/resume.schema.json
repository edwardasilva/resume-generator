  "$id": "https://raw.githubusercontent.com/edwardasilva/resume-generator/main/schema/resume.schema.json",
  "title": "resume-generator input",
  "description": "One resume or CV for build.py. A blank field or an empty list is left out of the PDF. A resume reads the education, projects, experience and skills sections. A CV, with settings.document set to cv, also reads the record sections, an education entry's location, thesis and honors, and settings.sectionTitles and settings.labels. The build checks each date against its section's date style. It notes a field it doesn't read and doesn't stop for it. The README field guide explains each field.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "document": {
          "enum": [
            "resume",
            "cv",
            null
          ],
          "default": "resume"
        },
        "sectionOrder": {
          "type": [
            "array",
            "null"
          ],
          "description": "A resume reads only education, projects, experience, skills. A section left out is left off the page.",
